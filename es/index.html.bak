  <style>
:root {
  --bg: #f5efe2; --bg-alt: #fbf7ee; --paper: #fffdf7;
  --ink: #2b2722; --ink-soft: #57504a; --ink-muted: #8a817a;
  --accent: #8b2e2e; --accent-soft: #b85a5a;
  --line: #e3d8c5; --line-strong: #cbbda3;
  --shadow: 0 2px 8px rgba(43,39,34,0.06), 0 12px 32px rgba(43,39,34,0.06);
  --radius: 14px; --maxw: 760px; --sidebar-w: 260px; --social-w: 78px;
  --serif: Georgia, "Iowan Old Style", "Times New Roman", "Noto Serif", serif;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body { margin: 0; font-family: var(--serif); font-size: 19px; line-height: 1.75; color: var(--ink); background: var(--bg); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
.progress-bar { position: fixed; top: 0; left: 0; height: 3px; width: 0%; background: var(--accent); z-index: 200; transition: width 0.12s linear; }
.lang-switch { position: fixed; top: 12px; right: 18px; display: flex; gap: 4px; z-index: 180; background: rgba(255,253,247,0.94); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); padding: 5px 6px; border-radius: 999px; border: 1px solid var(--line-strong); box-shadow: var(--shadow); font-family: var(--sans); }
.lang-switch a { font-size: 11px; font-weight: 600; letter-spacing: 0.04em; color: var(--ink-soft); text-decoration: none; padding: 4px 8px; border-radius: 999px; transition: background 0.15s, color 0.15s; text-transform: uppercase; }
.lang-switch a:hover { background: var(--line); color: var(--ink); }
.lang-switch a.active { background: var(--accent); color: #fff; }
.sidebar-left { position: fixed; top: 0; left: 0; bottom: 0; width: var(--sidebar-w); background: var(--bg-alt); border-right: 1px solid var(--line); padding: 32px 24px 24px; overflow-y: auto; z-index: 100; }
.sidebar-inner { display: flex; flex-direction: column; min-height: 100%; }
.brand { display: inline-flex; align-items: center; gap: 8px; font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); text-decoration: none; line-height: 1.25; }
.brand:hover { color: var(--accent); }
.brand-mark { color: var(--accent); font-size: 16px; flex-shrink: 0; }
.brand-sub { font-family: var(--sans); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink-muted); margin: 4px 0 28px; }
.toc-nav { display: flex; flex-direction: column; gap: 2px; padding-top: 16px; border-top: 1px solid var(--line); }
.toc-nav a { display: flex; align-items: baseline; gap: 10px; font-family: var(--sans); font-size: 13.5px; color: var(--ink-soft); text-decoration: none; padding: 9px 10px; border-radius: 8px; transition: background 0.15s, color 0.15s; line-height: 1.35; }
.toc-nav a:hover { background: var(--paper); color: var(--ink); }
.toc-nav a.active { background: var(--accent); color: #fff; }
.toc-nav a.active .toc-num { color: #fff; opacity: 0.85; }
.toc-num { display: inline-block; min-width: 18px; font-size: 11px; font-weight: 600; color: var(--accent); opacity: 0.7; text-align: center; flex-shrink: 0; }
.sidebar-foot { margin-top: auto; padding-top: 24px; font-family: var(--sans); font-size: 10px; letter-spacing: 0.14em; color: var(--ink-muted); text-transform: lowercase; }
.sidebar-right { position: fixed; top: 50%; right: 18px; transform: translateY(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; z-index: 100; padding: 4px; }
.social-label { font-family: var(--sans); font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-muted); writing-mode: vertical-rl; transform: rotate(180deg); margin-bottom: 4px; }
.social-line { width: 1px; height: 22px; background: var(--line-strong); }
.social-handle { font-family: var(--sans); font-size: 10px; letter-spacing: 0.04em; color: var(--ink-muted); writing-mode: vertical-rl; transform: rotate(180deg); margin-top: 4px; }
.social { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: var(--paper); border: 1px solid var(--line-strong); color: var(--ink-soft); text-decoration: none; font-family: var(--sans); font-size: 11px; font-weight: 700; transition: transform 0.15s, background 0.15s, color 0.15s, border-color 0.15s, box-shadow 0.15s; box-shadow: 0 1px 3px rgba(43,39,34,0.05); }
.social svg { fill: currentColor; }
.social-ig svg { fill: none; }
.social:hover { transform: translateY(-2px) scale(1.05); color: #fff; border-color: transparent; box-shadow: 0 6px 16px rgba(43,39,34,0.18); }
.social-tg:hover { background: #229ED9; }
.social-ok:hover { background: #EE8208; }
.social-vk:hover { background: #0077FF; }
.social-ig:hover { background: #E1306C; }
.social-tw:hover { background: #0f0f0f; }
.social-fb:hover { background: #1877F2; }
.mobile-header { display: none; position: sticky; top: 0; z-index: 150; background: rgba(245,239,226,0.96); backdrop-filter: saturate(140%) blur(8px); -webkit-backdrop-filter: saturate(140%) blur(8px); border-bottom: 1px solid var(--line); }
.mobile-inner { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; gap: 12px; min-height: 56px; }
.brand-mobile { font-size: 14px; flex: 1; min-width: 0; }
.brand-mobile .brand-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.menu-toggle { width: 40px; height: 40px; background: transparent; border: 1px solid var(--line-strong); border-radius: 8px; cursor: pointer; padding: 9px 8px; display: flex; flex-direction: column; justify-content: space-between; flex-shrink: 0; }
.menu-toggle span { display: block; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
.menu-toggle.open span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
.menu-toggle.open span:nth-child(2) { opacity: 0; }
.menu-toggle.open span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }
.mobile-nav { display: flex; flex-direction: column; gap: 0; background: var(--paper); border-top: 1px solid var(--line); padding: 0 12px; max-height: 0; overflow: hidden; transition: max-height 0.28s ease, padding 0.28s ease; }
.mobile-nav.open { max-height: 70vh; overflow-y: auto; padding-top: 8px; padding-bottom: 14px; }
.mobile-nav a { font-family: var(--sans); font-size: 14.5px; color: var(--ink-soft); text-decoration: none; padding: 12px 14px; border-radius: 8px; transition: background 0.15s, color 0.15s; }
.mobile-nav a:hover, .mobile-nav a.active { background: var(--accent); color: #fff; }
.main-content { margin-left: var(--sidebar-w); margin-right: var(--social-w); min-height: 100vh; }
.cover { padding: 96px 24px 64px; text-align: center; background: radial-gradient(ellipse at 50% 0%, rgba(139,46,46,0.06), transparent 55%), linear-gradient(180deg, var(--bg-alt), var(--bg)); border-bottom: 1px solid var(--line); }
.cover-inner { max-width: 620px; margin: 0 auto; }
.cover-kicker { font-family: var(--sans); font-size: 12px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--accent); margin: 0 0 20px; }
.cover-title { font-family: var(--serif); font-size: clamp(40px, 6vw, 64px); line-height: 1.05; margin: 0 0 18px; font-weight: 400; letter-spacing: -0.01em; }
.cover-subtitle { font-size: clamp(17px, 2.2vw, 21px); color: var(--ink-soft); margin: 0 0 14px; font-style: italic; }
.cover-tagline { font-family: var(--sans); font-size: 14px; color: var(--ink-muted); line-height: 1.6; margin: 0 0 42px; }
.cover-toc { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; padding-top: 26px; border-top: 1px solid var(--line); }
.cover-toc a { font-family: var(--sans); font-size: 12px; color: var(--ink-soft); text-decoration: none; padding: 5px 11px; border: 1px solid var(--line-strong); border-radius: 999px; transition: all 0.15s; }
.cover-toc a:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
.book { max-width: var(--maxw); margin: 0 auto; padding: 20px 32px 60px; }
.chapter { padding: 60px 0 40px; border-bottom: 1px solid var(--line); }
.chapter:last-child { border-bottom: none; }
.chapter-header { text-align: center; margin-bottom: 34px; }
.chapter-number { display: inline-block; font-family: var(--sans); font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; }
.chapter-header h2 { font-family: var(--serif); font-size: clamp(26px, 3.4vw, 36px); line-height: 1.2; margin: 0; font-weight: 400; letter-spacing: -0.005em; }
.chapter p { margin: 0 0 1.35em; text-align: justify; hyphens: auto; -webkit-hyphens: auto; }
.chapter p:first-of-type::first-letter { font-size: 3.2em; line-height: 0.9; float: left; padding: 6px 10px 0 0; font-weight: 400; color: var(--accent); }
.chapter-image { margin: 0 0 34px; border-radius: var(--radius); overflow: hidden; background: var(--bg-alt); border: 1px solid var(--line); box-shadow: var(--shadow); aspect-ratio: 16/9; position: relative; }
.chapter-image img { display: block; width: 100%; height: 100%; object-fit: cover; }
.chapter-image.image-missing::before { content: "📷  La imagen aparecerá aquí"; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--sans); font-size: 13px; color: var(--ink-muted); letter-spacing: 0.05em; background: repeating-linear-gradient(45deg, #efe6d3 0 20px, #eadfc8 20px 40px); }
.chapter-image.image-missing img { opacity: 0; }
.site-footer { max-width: var(--maxw); margin: 0 auto; padding: 50px 32px 70px; text-align: center; font-family: var(--sans); font-size: 13px; color: var(--ink-muted); border-top: 1px solid var(--line); }
.footer-title { font-size: 13px; color: var(--ink-soft); margin: 0 0 20px; }
.footer-socials { display: none; flex-wrap: wrap; gap: 10px; justify-content: center; margin: 0 0 20px; }
.footer-handle { font-size: 12px; color: var(--accent-soft); margin: 0 0 10px; letter-spacing: 0.04em; }
.footer-hash { font-size: 11.5px; color: var(--ink-muted); word-break: break-word; line-height: 1.7; margin: 0; }
.to-top { position: fixed; right: 20px; bottom: 20px; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--paper); color: var(--ink); font-size: 20px; cursor: pointer; opacity: 0; pointer-events: none; transform: translateY(10px); transition: opacity 0.25s, transform 0.25s, background 0.15s, color 0.15s; box-shadow: var(--shadow); z-index: 120; }
.to-top.show { opacity: 1; pointer-events: auto; transform: translateY(0); }
.to-top:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
@media (max-width: 1100px) {
  .sidebar-left, .sidebar-right { display: none; }
  .mobile-header { display: block; }
  .main-content { margin-left: 0; margin-right: 0; }
  .footer-socials { display: flex; }
  .cover { padding: 56px 20px 44px; }
  .book { padding: 10px 22px 50px; }
  .chapter { padding: 44px 0 32px; }
  html { scroll-padding-top: 76px; }
  .lang-switch { top: auto; bottom: 76px; right: 14px; }
}
@media (max-width: 560px) {
  body { font-size: 17px; }
  .cover-title { font-size: 38px; }
  .cover-subtitle { font-size: 16px; }
  .chapter-header h2 { font-size: 23px; }
  .chapter-number { font-size: 11px; }
  .book { padding: 8px 18px 40px; }
  .chapter { padding: 40px 0 28px; }
  .chapter p { text-align: left; }
  .chapter p:first-of-type::first-letter { font-size: 2.6em; padding: 4px 8px 0 0; }
  .chapter-image { aspect-ratio: 4/3; }
  .site-footer { padding: 40px 18px 60px; }
  .to-top { width: 42px; height: 42px; right: 14px; bottom: 14px; font-size: 18px; }
  .lang-switch { bottom: 70px; }
}
@media print {
  .sidebar-left, .sidebar-right, .mobile-header, .to-top,
  .progress-bar, .cover-toc, .footer-socials, .lang-switch { display: none !important; }
  body { background: #fff; font-size: 12pt; color: #000; }
  .main-content { margin: 0; }
  .chapter { page-break-after: always; border: none; padding: 0; }
  .chapter-image { box-shadow: none; aspect-ratio: auto; }
}
  </style>
</head>
