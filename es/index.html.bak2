  <button class="to-top" id="toTop" aria-label="Arriba">↑</button>

  <script>
(function () {
  "use strict";
  document.querySelectorAll(".chapter-image img").forEach(function (img) {
    img.addEventListener("error", function () { img.parentElement.classList.add("image-missing"); });
  });
  var menuToggle = document.getElementById("menuToggle");
  var mobileNav = document.getElementById("mobileNav");
  if (menuToggle && mobileNav) {
    menuToggle.addEventListener("click", function () {
      var isOpen = mobileNav.classList.toggle("open");
      menuToggle.classList.toggle("open", isOpen);
      menuToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
    mobileNav.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () {
        mobileNav.classList.remove("open");
        menuToggle.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
      });
    });
  }
  var progressBar = document.getElementById("progressBar");
  function updateProgress() {
    var s = window.scrollY || document.documentElement.scrollTop;
    var h = document.documentElement.scrollHeight - window.innerHeight;
    if (progressBar) progressBar.style.width = (h > 0 ? (s / h) * 100 : 0) + "%";
  }
  var toTop = document.getElementById("toTop");
  function toggleToTop() {
    if (!toTop) return;
    if (window.scrollY > 500) toTop.classList.add("show"); else toTop.classList.remove("show");
  }
  if (toTop) toTop.addEventListener("click", function () { window.scrollTo({ top: 0, behavior: "smooth" }); });
  var sections = Array.prototype.slice.call(document.querySelectorAll(".chapter"));
  var navLinks = Array.prototype.slice.call(document.querySelectorAll(".toc-nav a, .mobile-nav a"));
  function setActiveLink() {
    var fromTop = window.scrollY + 140, current = null;
    sections.forEach(function (s) { if (s.offsetTop <= fromTop) current = s.id; });
    navLinks.forEach(function (l) {
      var href = l.getAttribute("href"); if (!href) return;
      l.classList.toggle("active", href.replace("#","") === current);
    });
  }
  var ticking = false;
  function onScroll() {
    if (ticking) return; ticking = true;
    window.requestAnimationFrame(function () {
      updateProgress(); toggleToTop(); setActiveLink(); ticking = false;
    });
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  document.querySelectorAll('a[href^="#"]').forEach(function (a) {
    a.addEventListener("click", function (e) {
      var href = a.getAttribute("href");
      if (!href || href === "#" || href === "#top") {
        if (href === "#top") { e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }
        return;
      }
      var id = href.slice(1), target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      var isMobile = window.matchMedia("(max-width: 1100px)").matches;
      var offset = isMobile ? 76 : 40;
      var top = target.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top: top, behavior: "smooth" });
      history.replaceState(null, "", "#" + id);
    });
  });
  updateProgress(); toggleToTop(); setActiveLink();
})();
  </script>
</body>
