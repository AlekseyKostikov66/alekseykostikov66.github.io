      <a href="#top" class="brand">
        <span class="brand-mark">◈</span>
        <span class="brand-text">El Collar o&nbsp;el Amanecer</span>
      </a>
      <p class="brand-sub">breve libro</p>
      <nav class="toc-nav">
        <a href="#prolog"><span class="toc-num">∅</span>Prólogo</a>
        <a href="#chapter-1"><span class="toc-num">1</span>Teatro del absurdo</a>
        <a href="#chapter-2"><span class="toc-num">2</span>El votante que desaparece</a>
        <a href="#chapter-3"><span class="toc-num">3</span>La correa digital</a>
        <a href="#chapter-4"><span class="toc-num">4</span>Odres nuevos</a>
